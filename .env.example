# 必须用 ApiNebula 的 Grok 分组令牌；空着也能抓盘口，白话走本地模板
APINEBULA_API_KEY=
APINEBULA_BASE_URL=https://apinebula.ai/v1
GROK_MODEL=grok-4.6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
SHQBB_API_KEY=
SHQBB_BASE_URL=https://api.shqbb.com/v1
# Claude 单独一把钥匙；不填则回退到 SHQBB_API_KEY
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
GPT_MODEL=gpt-5.4-mini
LISTEN_ADDR=:8090
DATA_DIR=data
AI_LOG_DIR=logs/ai
AI_LOG_RETENTION=48h
TZ=Asia/Shanghai
# 仅竞彩/500.com 走代理；模型请求不走。例：http://127.0.0.1:8888
FETCH_PROXY=
# 管理后台 /admin。生产环境必须设置强密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# HTTPS 部署时设为 true
ACCESS_COOKIE_SECURE=false
# 管理入口与前端构建路径需保持一致；请改成你自己的随机路径
ADMIN_PATH=/console-k7m4x9
VITE_ADMIN_PATH=/console-k7m4x9
